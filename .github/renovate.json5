{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'schedule:monthly',
    'group:linters',
    ':semanticCommitsDisabled',
  ],
  automerge: true,
  dependencyDashboard: {
    enabled: true,
  },
  labels: [
    'dependencies',
  ],
  lockFileMaintenance: {
    enabled: true,
  },
  packageRules: [
    {
      matchCategories: [
        'python',
      ],
      minimumReleaseAge: '7 days',
    },
  ],
  ignorePaths: [],
}
